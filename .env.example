GOOGLE_API_KEY=your_google_api_key
# Primary Google model used by LangChain/LangGraph when LLM_PROVIDER=google
# Examples: gemini-3-flash-preview, gemini-2.5-flash-preview-09-2025
GOOGLE_MODEL=gemini-3-flash-preview

# Select active LLM backend: google | z.ai
# - google: uses ChatGoogleGenerativeAI with GOOGLE_API_KEY
# - z.ai: uses ChatOpenAI-compatible endpoint with ZAI_* settings
LLM_PROVIDER=google

# z.ai API settings (used when LLM_PROVIDER=z.ai)
# Example model: glm-4.7
ZAI_API_KEY=your_z_ai_api_key
ZAI_MODEL=glm-4.7
# Default OpenAI-compatible endpoint for z.ai
# Optional coding endpoint: https://api.z.ai/api/coding/paas/v4
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/

# Optional Google-specific vision model override (if used by your flow)
GOOGLE_VISION_MODEL=gemini-2.0-flash-exp
# Optional Google-specific vector config
GOOGLE_EMBED_MODEL=models/embedding-001
GOOGLE_VECTOR_LLM_MODEL=gemini-2.5-flash-lite-preview-09-2025

# LM Studio fallback for vector DB embeddings (used if Google vector init fails)
# Keep LM Studio running with OpenAI-compatible API and /v1/embeddings endpoint.
# Example from LM Studio screenshot:
# - LMSTUDIO_BASE_URL=http://127.0.0.1:1234
# - LMSTUDIO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
LMSTUDIO_BASE_URL=http://127.0.0.1:1234
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
# Optional: only needed if you want LM Studio chat model for vector query generation.
LMSTUDIO_LLM_MODEL=

# PostgreSQL connection fields (first DB attempted by the app)
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MySQL fallback connection fields (used only if PostgreSQL connection fails)
MYSQL_USERNAME=root
MYSQL_PASSWORD=password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=medical_db

# Shared/default DB name used by parts of the app
DATABASE_NAME=medical_db
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json
FLASK_SECRET_KEY=dev-key-please-change

LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=Health-Navigator
